package pagurus-core
version = 0.1.0
authors = "pagurus contributors"
license = "MIT"

sourcedir = "src"
depends = base

modules = Pagurus.IR
        , Pagurus.Status
        , Pagurus.Step
        , Pagurus.Lattice
        , Pagurus.Checker
        , Pagurus.Store
        , Pagurus.Conc
        , Pagurus.Soundness
        , Pagurus.Safety
        , Pagurus.Safety.Lit
        , Pagurus.Safety.Var
        , Pagurus.Safety.Args
        , Pagurus.Safety.Call
        , Pagurus.Safety.Assign
        , Pagurus.Safety.Decl
        , Pagurus.Safety.Drop
        , Pagurus.Safety.Return
        , Pagurus.Safety.If
        , Pagurus.Safety.Loop
        , Pagurus.Safety.Seq
        , Pagurus.Safety.Expr
        , Pagurus.Safety.Stmt
        , Pagurus.Sexp
        , Pagurus.ParseIR
        , Pagurus.Output

main = Main
executable = pagurus-core
